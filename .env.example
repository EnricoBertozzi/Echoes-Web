# URL da API do Echoes-Server.
# Em desenvolvimento: http://localhost:8080 (ver CORS_ALLOWED_ORIGINS no servidor).
# A sessão usa cookie HttpOnly; a API precisa estar no mesmo site que o front
# (mesmo host ou subdomínio), senão SESSION_COOKIE_SAMESITE=Strict bloqueia o cookie.
# Em produção, use https://.
VITE_API_URL=http://localhost:8080
